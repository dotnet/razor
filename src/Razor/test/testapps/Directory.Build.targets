<Project>
  <!-- Keep the fixtures on the legacy code-generation pipeline when using the installed SDK. -->
  <PropertyGroup>
    <UseRazorSourceGenerator Condition="'$(UseRazorSourceGenerator)' == ''">false</UseRazorSourceGenerator>
    <RazorLangVersion Condition="'$(RazorLangVersion)' == '' AND '$(TargetFrameworkIdentifier)' == '.NETCoreApp' AND $([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion)', '5.0'))">5.0</RazorLangVersion>
  </PropertyGroup>

  <Import Project="RazorTest.Introspection.targets" />
</Project>
